---
// Bottom tab bar, the main navigation below 1024px. Each tab has an outline icon and a filled one for the current section.
import Link from "./Link.astro";
import { icons } from "../Icon.astro";
import { pages, tabNav } from "../../lib/nav";
import { isCurrentSection } from "../../lib/site";

export interface Props {
    /** Page path without the deployment base, e.g. "/cenik/". */
    currentPath: string;
}

const { currentPath } = Astro.props;
// Outline paths come from Icon.astro where the icon exists there; the filled variants are tab-specific.
const glyphs: Record<string, { line: string; fill: string }> = {
    [pages.home.href]: {
        line: '<path d="M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5H15v-5.5H9v5.5H5.5A1.5 1.5 0 0 1 4 19z"/>',
        fill: '<path fill="currentColor" stroke="none" d="M12 3 3 10.3V19.5A1.5 1.5 0 0 0 4.5 21H9.5v-6h5v6h5a1.5 1.5 0 0 0 1.5-1.5v-9.2z"/>',
    },
    [pages.hours.href]: {
        line: '<circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 1.75"/>',
        fill: '<circle fill="currentColor" stroke="none" cx="12" cy="12" r="9"/><path stroke="#fff" stroke-width="2" d="M12 7.5V12l3 1.75"/>',
    },
    [pages.patients.href]: {
        line: '<circle cx="9.5" cy="8" r="3.5"/><path d="M3.25 19.5a6.25 6.25 0 0 1 12.5 0"/><path d="M16 4.75a3.5 3.5 0 0 1 0 6.5"/><path d="M17.25 14a6.25 6.25 0 0 1 3.5 5.5"/>',
        fill: '<circle fill="currentColor" stroke="none" cx="9.5" cy="8" r="4"/><path fill="currentColor" stroke="none" d="M3 20.5a6.5 6.5 0 0 1 13 0z"/><path d="M16 4.75a3.5 3.5 0 0 1 0 6.5"/><path d="M17.25 14a6.25 6.25 0 0 1 3.5 5.5"/>',
    },
    [pages.prices.href]: {
        line: icons.tag,
        fill: '<path fill="currentColor" d="M3.75 11.9V5.25c0-.83.67-1.5 1.5-1.5h6.65c.4 0 .78.16 1.06.44l7.1 7.1a1.5 1.5 0 0 1 0 2.12l-6.65 6.65a1.5 1.5 0 0 1-2.12 0l-7.1-7.1a1.5 1.5 0 0 1-.44-1.06z"/><circle fill="#fff" stroke="none" cx="8.25" cy="8.25" r="1.5"/>',
    },
    [pages.contact.href]: {
        line: icons.pin,
        fill: '<path fill="currentColor" d="M12 21.25s-6.75-6.2-6.75-11.25a6.75 6.75 0 0 1 13.5 0c0 5.05-6.75 11.25-6.75 11.25z"/><circle fill="#fff" stroke="none" cx="12" cy="10" r="2.5"/>',
    },
};
const tabs = tabNav.map((page) => ({ ...page, ...glyphs[page.href] }));
---

<nav class="tabbar" aria-label="Hlavní navigace">
    {
        tabs.map(({ href, label, short, line, fill }) => (
            <Link class="tab" href={href} aria-current={isCurrentSection(currentPath, href) ? "page" : undefined}>
                <svg class="icon tab-line" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={line} />
                <svg class="icon tab-fill" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={fill} />
                <span>{short ?? label}</span>
            </Link>
        ))
    }
</nav>
