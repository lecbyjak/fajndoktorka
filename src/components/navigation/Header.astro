---
import Icon from "../Icon.astro";
import Link from "./Link.astro";
import Logo from "./Logo.astro";
import OfficeStatus from "../structured/OfficeStatus.astro";
import { headerNav } from "../../lib/nav";
import { isCurrentSection, phoneHref, type SiteData } from "../../lib/site";

export interface Props {
    /** Page path without the deployment base, e.g. "/cenik/". */
    currentPath: string;
    site: SiteData;
}

const { currentPath, site } = Astro.props;

---

{/* Below 1024px the navigation moves to the bottom tab bar (TabBar.astro); the header keeps the brand and live status. */}
<header class="site-header">
    <div class="shell header-inner">
        <Logo />
        <nav class="site-nav" aria-label="Hlavní navigace">
            {
                headerNav.map(({ href, label }) => (
                    <Link href={href} aria-current={isCurrentSection(currentPath, href) ? "page" : undefined}>
                        {label}
                    </Link>
                ))
            }
        </nav>
        <div class="header-actions">
            <OfficeStatus />
            <a class="button header-call" href={phoneHref(site.phone)}>
                <Icon name="phone" /><span>Zavolat<span class="header-phone"> {site.phone}</span></span>
            </a>
        </div>
    </div>
</header>
