---
import Link from "./Link.astro";

export interface Props {
    /** Page path without the deployment base, e.g. "/cenik/". */
    currentPath: string;
}

const path = decodeURI(Astro.props.currentPath).replace(/\/+$/, "") || "/";
const navItems = [
    { href: "/", label: "Domů" },
    { href: "/o-ordinaci/", label: "O ordinaci" },
    { href: "/o-nas/", label: "Náš tým" },
    { href: "/ordinacni-hodiny/", label: "Ordinační hodiny" },
    { href: "/informace-pro-pacienty/", label: "Pro pacienty" },
    { href: "/cenik/", label: "Ceník" },
    { href: "/mapa/", label: "Kontakt" },
];
const isActive = (href: string) => {
    const target = href.replace(/\/+$/, "") || "/";
    return target === "/"
        ? path === "/"
        : path === target || path.startsWith(`${target}/`);
};
---

<header class="site-header">
    <div class="header-inner">
        <Link class="brand" href="/" aria-label="FajnDoktorka – domů">
            <span class="brand-mark" aria-hidden="true">FD</span>
            <span class="brand-copy">
                <strong>FajnDoktorka</strong>
                <small>Ordinace praktického lékaře</small>
            </span>
        </Link>
        <nav
            class="site-nav"
            id="site-navigation"
            data-open="false"
            aria-label="Hlavní navigace"
        >
            {
                navItems.map(({ href, label }) => (
                    <Link
                        href={href}
                        aria-current={isActive(href) ? "page" : undefined}
                    >
                        {label}
                    </Link>
                ))
            }
        </nav>
        {/* Toggled by src/scripts/site.ts; visible below 980px. */}
        <button
            class="menu-toggle"
            type="button"
            aria-controls="site-navigation"
            aria-expanded="false"
            aria-label="Otevřít menu"
        >
            <span></span><span></span><span></span>
        </button>
    </div>
</header>
