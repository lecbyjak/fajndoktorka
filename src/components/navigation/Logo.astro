---
// Brand mark + wordmark. The mark mirrors public/favicon.svg.
import Link from "./Link.astro";

export interface Props {
    /** Larger wordmark for the footer. */
    size?: "default" | "large";
}

const { size = "default" } = Astro.props;
---

<Link class:list={["brand", `brand--${size}`]} href="/" aria-label="FajnDoktorka – domů">
    <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <rect width="64" height="64" rx="20" fill="var(--lime)"></rect>
        <rect x="26" y="13" width="12" height="38" rx="6" fill="var(--ink)"></rect>
        <rect x="13" y="26" width="38" height="12" rx="6" fill="var(--ink)"></rect>
        <circle cx="32" cy="32" r="4.5" fill="var(--lime)"></circle>
    </svg>
    <span class="brand-name"><em>Fajn</em>Doktorka</span>
</Link>
