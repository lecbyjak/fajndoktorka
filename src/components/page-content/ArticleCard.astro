---
import Link from "../navigation/Link.astro";

export interface Props {
    href: string;
    title: string;
    description: string;
    cta?: string;
    class?: string;
}

const {
    href,
    title,
    description,
    cta = "Přečíst →",
    class: className = "",
} = Astro.props;
---

<Link class:list={["feature-card", className]} href={href}>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="card-arrow" aria-hidden="true">{cta}</span>
</Link>
