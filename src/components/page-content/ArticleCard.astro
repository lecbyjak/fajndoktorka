---
import Link from "../navigation/Link.astro";

export interface Props {
    href: string;
    title: string;
    description: string;
    cta?: string;
}

const { href, title, description, cta = "Přečíst →" } = Astro.props;
---

<Link class="feature-card" href={href}>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="card-arrow" aria-hidden="true">{cta}</span>
</Link>
