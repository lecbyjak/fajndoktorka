---
import Link from "../navigation/Link.astro";
import { mapsSearchUrl, phoneHref, type SiteData } from "../../lib/site";

export interface Props {
    site: SiteData;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
const district = site.address.locality.split(" – ")[0];
---

<footer class="site-footer">
    <div class="shell">
        <div class="footer-grid">
            <div>
                <h2>{site.name}</h2>
                <p>
                    Praktická medicína postavená na srozumitelnosti, důvěře a
                    dlouhodobé péči.
                </p>
                <a class="button footer-call" href={phoneHref(site.phone)}>
                    Zavolat do ordinace
                </a>
            </div>
            <div>
                <h3>Ordinace</h3>
                <Link href="/ordinacni-hodiny/">Ordinační hodiny</Link>
                <Link href="/o-nas/">Náš tým</Link>
                <Link href="/cenik/">Ceník</Link>
                <Link href="/pristroje/">Vybavení ordinace</Link>
                <Link href="/blog/">Aktuality z ordinace</Link>
            </div>
            <div>
                <h3>Kontakt</h3>
                <a href={phoneHref(site.phone)}>{site.phone}</a>
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <a href={mapsSearchUrl(site)} target="_blank" rel="noopener">
                    {site.address.street}, {district}
                </a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© {year} {site.name}</span>
            <span>IČO {site.ico} · V akutním ohrožení volejte 155.</span>
        </div>
    </div>
</footer>
<button class="back-to-top" type="button" aria-label="Zpět nahoru">↑</button>
