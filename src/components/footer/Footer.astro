---
import Link from "../navigation/Link.astro";
import Logo from "../navigation/Logo.astro";
import { mapsSearchUrl, phoneHref, type SiteData } from "../../lib/site";

export interface Props {
    site: SiteData;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="shell">
        <div class="footer-grid">
            <div class="footer-brand">
                <Logo size="large" />
                <p>Praktická medicína postavená na srozumitelnosti, důvěře a dlouhodobé péči.</p>
            </div>
            <div>
                <h3>Ordinace</h3>
                <Link href="/o-ordinaci/">O ordinaci</Link>
                <Link href="/o-nas/">Náš tým</Link>
                <Link href="/ordinacni-hodiny/">Ordinační hodiny</Link>
                <Link href="/pristroje/">Vybavení ordinace</Link>
                <Link href="/blog/">Aktuality z ordinace</Link>
            </div>
            <div>
                <h3>Pro pacienty</h3>
                <Link href="/informace-pro-pacienty/#prakticke-informace">Praktické informace</Link>
                <Link href="/informace-pro-pacienty/#lecba-a-domaci-pece">Léčba a domácí péče</Link>
                <Link href="/informace-pro-pacienty/#prevence-a-ockovani">Prevence a očkování</Link>
                <Link href="/cenik/">Ceník</Link>
            </div>
            <div>
                <h3>Kontakt</h3>
                <a href={phoneHref(site.phone)}>{site.phone}</a>
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <a href={mapsSearchUrl(site)} target="_blank" rel="noopener">
                    {site.address.street}<br />{site.address.postalCode} {site.address.locality}
                </a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© {year} {site.name} · IČO {site.ico}</span>
            <span>V akutním ohrožení života volejte <strong>155</strong>.</span>
        </div>
    </div>
</footer>
<button class="back-to-top" type="button" aria-label="Zpět nahoru">↑</button>
