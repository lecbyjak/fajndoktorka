---
import Link from "../navigation/Link.astro";
import { footerNav } from "../../lib/nav";
import type { SiteData } from "../../lib/site";

export interface Props {
    site: SiteData;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="shell footer-inner">
        <nav aria-label="Další stránky">
            {footerNav.map(({ href, label }) => <Link href={href}>{label}</Link>)}
        </nav>
        <div class="footer-meta">
            <p>© {year} {site.name} · Poliklinika Mazurská, {site.address.locality} · IČO {site.ico}</p>
            <p>V akutním ohrožení života volejte <strong>155</strong>.</p>
        </div>
    </div>
</footer>
<button class="back-to-top" type="button" aria-label="Zpět nahoru">↑</button>
