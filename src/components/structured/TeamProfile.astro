---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { byOrder } from "../../lib/site";

export interface Props {
    entries: CollectionEntry<"staff">[];
}

const entries = Astro.props.entries.toSorted(byOrder);
---

{
    entries.map(({ data }, index) => (
        <div class="profile-layout">
            <figure class="team-portrait">
                <Image
                    src={data.portrait}
                    alt={data.name}
                    width={496}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : undefined}
                />
            </figure>
            <article class="profile-content">
                <p class="eyebrow">{data.role}</p>
                <h2>{data.name}</h2>
                <section class="credential-section">
                    <h3>Vzdělání</h3>
                    <ul>
                        {data.education.map((item) => <li>{item}</li>)}
                    </ul>
                </section>
                <section class="credential-section">
                    <h3>Členství v odborných společnostech</h3>
                    <ul>
                        {data.memberships.map((item) => <li>{item}</li>)}
                    </ul>
                </section>
                <section class="credential-section">
                    <h3>Praxe</h3>
                    <dl>
                        {data.experience.map((item) => {
                            // Entries are written as "period — workplace".
                            const [period, workplace] = item.split(/\s+—\s+/, 2);
                            return (
                                <div>
                                    <dt>{period}</dt>
                                    <dd>{workplace}</dd>
                                </div>
                            );
                        })}
                    </dl>
                </section>
            </article>
        </div>
    ))
}
