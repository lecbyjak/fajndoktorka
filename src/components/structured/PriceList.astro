---
import type { CollectionEntry } from "astro:content";
import { byOrder } from "../../lib/site";

export interface Props {
    entries: CollectionEntry<"pricing">[];
}

// Categories render in the order of their first item.
const sections = Map.groupBy(
    Astro.props.entries.toSorted(byOrder),
    ({ data }) => data.category,
);
---

<div class="price-list">
    {
        [...sections].map(([category, items]) => (
            <section class="price-section">
                <header>
                    <h2>{category}</h2>
                </header>
                {items.map(({ data }) => (
                    <div class="price-row">
                        <span>{data.service}</span>
                        <strong>{data.price}</strong>
                    </div>
                ))}
            </section>
        ))
    }
</div>
