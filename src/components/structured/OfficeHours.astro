---
import type { CollectionEntry } from "astro:content";
import { byOrder } from "../../lib/site";

export interface Props {
    entries: CollectionEntry<"officeHours">[];
}

const entries = Astro.props.entries.toSorted(byOrder);
const purposeLabels = {
    acute: "Akutní pacienti",
    appointment: "Objednaní pacienti",
    prebooked: "Pouze předem objednaní",
    "vaccination-and-sampling": "Očkování a odběry",
} satisfies Record<CollectionEntry<"officeHours">["data"]["slots"][number]["purpose"], string>;
---

<section class="schedule-board" aria-labelledby="weekly-schedule-title">
    <div class="schedule-board-heading">
        <div>
            <p class="eyebrow">Pondělí až pátek</p>
            <h2 id="weekly-schedule-title">Týdenní přehled</h2>
        </div>
        <p>
            Časy se liší podle typu návštěvy. Vyberte den a zkontrolujte
            správný časový blok.
        </p>
    </div>
    <div class="schedule-days">
        {
            entries.map(({ data }) => (
                <article class="schedule-day">
                    <header>
                        <h3>{data.day}</h3>
                        <p>
                            <span>Ordinuje</span>
                            {data.clinician}
                        </p>
                    </header>
                    <ol class="schedule-slots">
                        {data.slots.map((slot) => (
                            <li data-purpose={slot.purpose}>
                                <strong>
                                    <time datetime={slot.from}>{slot.from}</time> – <time datetime={slot.to}>{slot.to}</time>
                                </strong>
                                <span>{purposeLabels[slot.purpose]}</span>
                            </li>
                        ))}
                    </ol>
                </article>
            ))
        }
    </div>
</section>
