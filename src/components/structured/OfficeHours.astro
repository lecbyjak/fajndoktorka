---
// Week schedule as a timeline: one row per day, slots positioned on a 07–20 h
// axis via CSS custom properties. Collapses to a list below 980px. The client
// script marks the current day with `.is-today`.
import { purposeLabels, toHours, type Purpose, type WeekDay } from "../../lib/office-status";

export interface Props {
    week: WeekDay[];
}

const { week } = Astro.props;
const start = 7;
const end = 20;
const ticks = Array.from({ length: end - start + 1 }, (_, i) => start + i);
const usedPurposes = [...new Set(week.flatMap((day) => day.slots.map((slot) => slot.purpose)))] as Purpose[];
---

<div class="timeline" style={`--start: ${start}; --end: ${end}`}>
    <div class="timeline-axis" aria-hidden="true">
        <div></div>
        <div>{ticks.map((h) => <span style={`--h: ${h}`}>{h}</span>)}</div>
    </div>
    {
        week.map((day) => (
            <article class="timeline-row" data-weekday={day.weekday}>
                <div class="timeline-day">
                    <h3>
                        {day.day}
                        <small>Dnes</small>
                    </h3>
                    <p>{day.clinician}</p>
                </div>
                <ol class="timeline-track">
                    {day.slots.map((slot) => {
                        const hours = toHours(slot.to) - toHours(slot.from);
                        return (
                            <li
                                class:list={["timeline-slot", { "timeline-slot--short": hours < 1.5 }]}
                                data-purpose={slot.purpose}
                                style={`--from: ${toHours(slot.from)}; --to: ${toHours(slot.to)}`}
                                title={purposeLabels[slot.purpose]}
                            >
                                <strong>
                                    <time datetime={slot.from}>{slot.from}</time>–<time datetime={slot.to}>{slot.to}</time>
                                </strong>
                                <span>{purposeLabels[slot.purpose]}</span>
                            </li>
                        );
                    })}
                </ol>
            </article>
        ))
    }
    <ul class="timeline-legend">
        {usedPurposes.map((purpose) => <li data-purpose={purpose}>{purposeLabels[purpose]}</li>)}
    </ul>
</div>
