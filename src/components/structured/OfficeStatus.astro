---
// Live open/closed pill ("Otevřeno · do 14:30"), filled in by src/scripts/office-status.ts; hidden without JavaScript.
export interface Props {
    /** "dark" sits on the ink today card. */
    tone?: "light" | "dark";
    class?: string;
}

const { tone = "light", class: className } = Astro.props;
---

<p class:list={["office-status", `office-status--${tone}`, className]} data-office-status hidden>
    <span class="office-status-dot" aria-hidden="true"></span>
    <span><span data-office-label></span><span class="office-status-detail"> · <span data-office-detail></span></span></span>
</p>
