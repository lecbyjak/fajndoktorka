---
import Icon from "../Icon.astro";
import { mapsDirectionsUrl, mapsEmbedUrl, mapsSearchUrl, phoneHref, type SiteData } from "../../lib/site";

export interface Props {
    clinic: SiteData;
}

const { clinic } = Astro.props;
const clinicPhoneHref = phoneHref(clinic.phone);
---

<section class="contact-overview" aria-labelledby="contact-location-title">
    <div>
        <p class="eyebrow">Poliklinika Mazurská</p>
        <h2 id="contact-location-title">Jsme snadno dostupní v Praze 8</h2>
        <p class="lead">Objednejte se telefonicky před návštěvou. Pro neurgentní dotazy můžete využít e-mail.</p>

        <ul class="group contact-methods">
            <li>
                <a class="row" href={clinicPhoneHref}>
                    <span class="tile tile--lime"><Icon name="phone" /></span>
                    <span class="row-body">
                        <span class="row-label">Telefon</span>
                        <strong>{clinic.phone}</strong>
                        <small>Objednání a konzultace</small>
                    </span>
                    <Icon name="chevron" class="chevron" />
                </a>
            </li>
            <li>
                <a class="row" href={`mailto:${clinic.email}`}>
                    <span class="tile"><Icon name="mail" /></span>
                    <span class="row-body">
                        <span class="row-label">E-mail</span>
                        <strong>{clinic.email}</strong>
                        <small>Neurgentní dotazy</small>
                    </span>
                    <Icon name="chevron" class="chevron" />
                </a>
            </li>
            <li>
                <a class="row" href={mapsDirectionsUrl(clinic)} target="_blank" rel="noopener">
                    <span class="tile tile--blue"><Icon name="pin" /></span>
                    <span class="row-body">
                        <span class="row-label">Adresa ordinace</span>
                        <strong>{clinic.address.street}</strong>
                        <small>{clinic.address.postalCode} {clinic.address.locality} · naplánovat trasu</small>
                    </span>
                    <Icon name="chevron" class="chevron" />
                </a>
            </li>
        </ul>
        <p class="contact-legal">IČO {clinic.ico}</p>
    </div>

    <div class="location-map">
        <iframe
            title={`Mapa ordinace ${clinic.name}, ${clinic.address.street}`}
            src={mapsEmbedUrl(clinic)}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
        />
        <a href={mapsSearchUrl(clinic)} target="_blank" rel="noopener">Otevřít ve větší mapě →</a>
    </div>
</section>
