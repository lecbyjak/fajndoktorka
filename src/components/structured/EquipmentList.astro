---
import type { CollectionEntry } from "astro:content";
import { byOrder } from "../../lib/site";

export interface Props {
    entries: CollectionEntry<"equipment">[];
}

const entries = Astro.props.entries.toSorted(byOrder);
---

<div class="equipment-grid">
    {
        entries.map(({ data }) => (
            <article class="equipment-card">
                <h2>{data.name}</h2>
                <dl>
                    <div>
                        <dt>Co to je?</dt>
                        <dd>{data.description}</dd>
                    </div>
                    <div>
                        <dt>Na co to je?</dt>
                        <dd>{data.purpose}</dd>
                    </div>
                    <div>
                        <dt>Jak vyšetření probíhá?</dt>
                        <dd>{data.procedure}</dd>
                    </div>
                </dl>
            </article>
        ))
    }
</div>
