---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { NEWS_PATH } from "../../lib/articles";

export async function getStaticPaths() {
    const posts = (await getCollection("articles"))
        .filter((entry) => entry.data.category === "news")
        .sort((a, b) => a.data.navigationOrder - b.data.navigationOrder);

    return posts.map((entry) => ({
        // The content schema guarantees `path` starts with NEWS_PATH.
        params: { slug: entry.data.path.slice(NEWS_PATH.length, -1) },
        props: { entry, posts },
    }));
}

interface Props {
    entry: CollectionEntry<"articles">;
    posts: CollectionEntry<"articles">[];
}

const { entry, posts } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
    title={entry.data.title}
    description={entry.data.description}
    sources={entry.data.sources}
    breadcrumbs={[
        { label: "Domů", href: "/" },
        { label: "Aktuality z ordinace", href: "/blog/" },
        { label: entry.data.title },
    ]}
    sideNavigation={[
        { href: "/blog/", label: "Aktuality z ordinace" },
        ...posts.map((post) => ({
            href: post.data.path,
            label: post.data.title,
            current: post.id === entry.id,
        })),
    ]}
    sideNavigationLabel="Aktuality"
>
    <Content />
</ArticleLayout>
