---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { NEWS_PATH } from "../../lib/articles";
import { getNews, type NewsEntry } from "../../lib/collections";

export async function getStaticPaths() {
    const posts = await getNews();

    return posts.map((entry) => ({
        // The content schema guarantees `path` starts with NEWS_PATH.
        params: { slug: entry.data.path.slice(NEWS_PATH.length, -1) },
        props: { entry, posts },
    }));
}

interface Props {
    entry: NewsEntry;
    posts: NewsEntry[];
}

const { entry, posts } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
    title={entry.data.title}
    description={entry.data.description}
    sources={entry.data.sources}
    byline={{ author: entry.data.author, published: entry.data.published }}
    breadcrumbs={[
        { label: "Domů", href: "/" },
        { label: "Aktuality z ordinace", href: "/blog/" },
        { label: entry.data.title },
    ]}
    sideNavigation={[
        { href: "/blog/", label: "Aktuality z ordinace" },
        ...posts.map((post) => ({
            href: post.data.path,
            label: post.data.title,
            current: post.id === entry.id,
        })),
    ]}
    sideNavigationLabel="Aktuality"
>
    <Content />
</ArticleLayout>
