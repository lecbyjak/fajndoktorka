---
import { getCollection } from "astro:content";
import LandingLayout from "../layouts/LandingLayout.astro";
import PriceList from "../components/structured/PriceList.astro";
import { getSite, phoneHref } from "../lib/site";

const [entries, site] = await Promise.all([getCollection("pricing"), getSite()]);
---

<LandingLayout
    title="Ceník"
    description="Ceník výkonů nehrazených z veřejného zdravotního pojištění."
    lead="Ceny výkonů nehrazených z veřejného zdravotního pojištění. U očkování se výsledná cena může lišit podle zvolené vakcíny."
>
    <PriceList {entries} />
    <div class="price-note">
        <p>Potřebujete upřesnit cenu konkrétního výkonu? Zavolejte nám na <a href={phoneHref(site.phone)}>{site.phone}</a>.</p>
    </div>
</LandingLayout>
