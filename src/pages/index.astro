---
import { getCollection } from "astro:content";
import ArticleCard from "../components/page-content/ArticleCard.astro";
import Link from "../components/navigation/Link.astro";
import ContactPanel from "../components/structured/ContactPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryAnchor, patientCategories, type PatientCategory } from "../lib/articles";
import { getSite, phoneHref } from "../lib/site";

const [clinic, pinnedNews] = await Promise.all([
    getSite(),
    getCollection("articles", ({ data }) => data.category === "news" && data.pinned),
]);

const features = [
    {
        href: "/o-nas/",
        title: "Kdo jsme",
        description: "Jsme zdravotníci a chceme se o vás starat.",
    },
    {
        href: "/o-ordinaci/",
        title: "Jak to vidíme",
        description:
            "Koukněte se, jaký je náš pohled na poskytování zdravotní péče.",
    },
    {
        href: "/mapa/",
        title: "Kde nás najdete",
        description: "Naše ordinace je na Poliklinice Mazurská.",
    },
    {
        href: "/ordinacni-hodiny/",
        title: "Kdy tu budeme",
        description: "I my musíme odpočívat. Zkoukněte ordinační hodiny.",
    },
];

const topics = [
    ...(["practical", "medical", "prevention"] as const satisfies PatientCategory[]).map((category) => ({
        href: categoryAnchor(category),
        title: patientCategories[category].title,
        description: patientCategories[category].summary,
    })),
    {
        href: "/cenik/",
        title: "Ceník",
        description: "Aktuální ceník administrativních a léčebných úkonů.",
    },
];
---

<BaseLayout title={clinic.name} description={clinic.description}>
    <main id="obsah">
        <section class="hero">
            <div class="shell hero-grid">
                <div>
                    <p class="eyebrow">Ordinace praktického lékaře</p>
                    <h1>FAJNDOKTORKA</h1>
                    <p class="lead">
                        Praktická péče srozumitelně, lidsky a v souvislostech.
                    </p>
                    <div class="actions">
                        <a class="button" href={phoneHref(clinic.phone)}>
                            Zavolat do ordinace
                        </a>
                        <Link
                            class="button secondary"
                            href="/ordinacni-hodiny/"
                        >
                            Kdy ordinujeme
                        </Link>
                    </div>
                </div>
                <ContactPanel {clinic} compact />
            </div>
        </section>
        {
            pinnedNews.map(({ data }) => (
                <div class="notice shell">
                    <div class="notice-inner">
                        <div>
                            <strong>{data.title}</strong>
                            <p>{data.description}</p>
                        </div>
                        <Link class="button secondary" href={data.path}>
                            Více informací
                        </Link>
                    </div>
                </div>
            ))
        }
        <section class="section">
            <div class="shell">
                <div class="section-heading">
                    <h2>Péče, která dává smysl</h2>
                    <p>
                        Od prvního kontaktu po dlouhodobé sledování. Všechny
                        důležité informace najdete přehledně na jednom místě.
                    </p>
                </div>
                <div class="home-card-grid">
                    {features.map((feature) => <ArticleCard {...feature} cta="Zjistit více →" />)}
                </div>
            </div>
        </section>
        <section class="section">
            <div class="shell">
                <div class="section-heading">
                    <h2>Co potřebujete vyřešit?</h2>
                    <p>
                        Vyberte oblast a rychle se dostaňte k praktickým
                        informacím, doporučením pro pacienty, vybavení ordinace
                        nebo prevenci.
                    </p>
                </div>
                <div class="home-card-grid">
                    {topics.map((topic) => <ArticleCard {...topic} cta="Prohlédnout →" />)}
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
