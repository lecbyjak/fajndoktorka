---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import TopicCard from "../components/page-content/TopicCard.astro";
import Link from "../components/navigation/Link.astro";
import ContactCard from "../components/structured/ContactCard.astro";
import TodayCard from "../components/structured/TodayCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryAnchor, patientCategories } from "../lib/articles";
import { getNews, getWeek } from "../lib/collections";
import { byOrder, getSite } from "../lib/site";

const [clinic, week, news, staff, equipment] = await Promise.all([
    getSite(),
    getWeek(),
    getNews(),
    getCollection("staff"),
    getCollection("equipment"),
]);
const pinnedNews = news.filter(({ data }) => data.pinned);
// "Nové" badge window; src/scripts/site.ts shows the badge until it passes.
const NEW_FOR_MS = 30 * 24 * 60 * 60 * 1000;
const doctor = staff.toSorted(byOrder)[0]?.data;
const instruments = equipment.toSorted(byOrder).map(({ data }) => data.name);

const topics = [
    { href: categoryAnchor("practical"), title: patientCategories.practical.title, description: "Neschopenka, lázně, příspěvek na péči, lékárnička na dovolenou.", icon: "document", tone: "violet" },
    { href: categoryAnchor("medical"), title: patientCategories.medical.title, description: "Srozumitelně o častých diagnózách: tlak, cukrovka, cholesterol…", icon: "heart", tone: "lime" },
    { href: categoryAnchor("prevention"), title: patientCategories.prevention.title, description: "Chřipka, klíšťová encefalitida, pneumokoky, tetanus…", icon: "shield", tone: "blue" },
    { href: "/cenik/", title: "Ceník", description: "Aktuální ceník úkonů nehrazených pojišťovnou.", icon: "tag", tone: "violet" },
] as const;

const clinicLinks = [
    { href: "/o-nas/", title: "Náš tým", description: "Kdo se o vás stará.", icon: "stethoscope", tone: "violet" },
    { href: "/o-ordinaci/", title: "Jak pracujeme", description: "Náš pohled na léčebnou péči a návštěvní službu.", icon: "compass", tone: "lime" },
    { href: "/pristroje/", title: "Přístroje", description: instruments.join(", "), icon: "monitor", tone: "blue" },
    { href: "/mapa/", title: "Kde nás najdete", description: `Poliklinika Mazurská, ${clinic.address.locality}.`, icon: "pin", tone: "violet" },
] as const;
---

<BaseLayout title={`Praktický lékař ${clinic.address.locality}`} description={clinic.description}>
    <main id="obsah">
        <section class="hero" aria-labelledby="hero-title">
            <div class="shell hero-grid">
                <div class="hero-copy">
                    <p class="eyebrow">
                        <span><span class="only-wide">Ordinace praktického lékaře</span><span class="only-narrow">Praktický lékař</span> · {clinic.address.locality}</span>
                    </p>
                    <h1 id="hero-title">Praktická péče srozumitelně, <em class="marker">lidsky</em> a v souvislostech.</h1>
                    <p class="lead">
                        Od prvního kontaktu po dlouhodobé sledování. Vysvětlíme, co se děje, a společně vybereme postup, kterému rozumíte.
                    </p>
                </div>
                <TodayCard {week} site={clinic} />
            </div>
        </section>

        <div class="sheet sheet--home">
            <div class="shell sheet-stack">
                {
                    pinnedNews.length > 0 && (
                        <section class="news" aria-labelledby="news-title">
                            <div class="news-head">
                                <h2 id="news-title"><span>Aktuálně<span class="only-wide"> z ordinace</span></span></h2>
                                <Link href="/blog/">
                                    <span class="only-wide">Všechny aktuality →</span>
                                    <span class="only-narrow">Vše</span>
                                </Link>
                            </div>
                            <ul class="news-list">
                                {pinnedNews.map(({ data }) => (
                                    <li>
                                        <Link class="news-item" href={data.path}>
                                            <span class="news-body">
                                                <span class="news-title">
                                                    {data.title}
                                                    <span class="badge" data-new-until={new Date(data.published.getTime() + NEW_FOR_MS).toISOString()} hidden>
                                                        Nové
                                                    </span>
                                                </span>
                                                <span class="news-desc">{data.description}</span>
                                            </span>
                                            <span class="news-arrow only-wide" aria-hidden="true">→</span>
                                            <Icon name="chevron" class="chevron only-narrow" />
                                        </Link>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }

                <section class="topics" aria-labelledby="topics-title">
                    <div class="section-heading only-wide">
                        <div>
                            <p class="eyebrow">Rozcestník</p>
                            <h2 id="topics-title">Co potřebujete vyřešit?</h2>
                        </div>
                        <p>Vyberte oblast a dostaňte se rovnou k praktickým informacím, doporučením k léčbě, prevenci nebo ceníku.</p>
                    </div>
                    <div class="section-head only-narrow">
                        <h2>Pro pacienty</h2>
                        <Link href="/informace-pro-pacienty/">Vše</Link>
                    </div>
                    <ul class="card-grid card-grid--4">
                        {topics.map((topic) => <TopicCard {...topic} />)}
                    </ul>
                </section>

                <section class="clinic" aria-labelledby="clinic-title">
                    <div class="section-head">
                        <h2 id="clinic-title">Ordinace</h2>
                    </div>
                    <ul class="card-grid card-grid--4">
                        {clinicLinks.map((link) => <TopicCard {...link} />)}
                    </ul>

                    {
                        doctor && (
                            <div class="doctor">
                                <Link class="doctor-link" href="/o-nas/">
                                    <Image class="avatar" src={doctor.portrait} alt="" width={192} height={192} loading="lazy" />
                                    <span class="doctor-body">
                                        <strong>{doctor.name}</strong>
                                        <span>{doctor.role}</span>
                                    </span>
                                    <Icon name="chevron" class="chevron" />
                                </Link>
                                <blockquote class="doctor-quote">
                                    „Zastáváme názor, že velmi dobrá informovanost a znalost zdravotního stavu jsou nedílnou součástí
                                    léčebně preventivního procesu.“
                                </blockquote>
                            </div>
                        )
                    }
                </section>

                <ContactCard site={clinic} />
            </div>
        </div>
    </main>
</BaseLayout>
