---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/page-content/PageHero.astro";
import Link from "../components/navigation/Link.astro";
---

<BaseLayout
    title="Stránka nebyla nalezena"
    description="Požadovaná stránka nebyla nalezena."
    noindex
>
    <main id="obsah">
        <PageHero
            title="Stránka nebyla nalezena"
            lead="Odkaz už možná není aktuální. Všechny důležité informace najdete na úvodní stránce."
            breadcrumbs={[]}
        >
            <div class="actions">
                <Link class="button" href="/">Zpět na hlavní stránku</Link>
            </div>
        </PageHero>
    </main>
</BaseLayout>
