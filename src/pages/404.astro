---
import BaseLayout from "../layouts/BaseLayout.astro";
import Link from "../components/navigation/Link.astro";
---

<BaseLayout
    title="Stránka nebyla nalezena"
    description="Požadovaná stránka nebyla nalezena."
    currentPath="/404.html"
>
    <main id="obsah">
        <section class="page-hero">
            <div class="shell">
                <p class="eyebrow">Chyba 404</p><h1>
                    Stránka nebyla nalezena
                </h1><p class="lead">
                    Odkaz už možná není aktuální. Všechny důležité informace
                    najdete na úvodní stránce.
                </p><div class="actions">
                    <Link class="button" href="/">Zpět na hlavní stránku</Link>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
