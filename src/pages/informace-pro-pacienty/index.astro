---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/page-content/ArticleCard.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { patientCategories, type PatientCategory } from "../../lib/articles";
import { getSite, phoneHref } from "../../lib/site";

const [articles, site] = await Promise.all([getCollection("articles"), getSite()]);
const sections = Object.entries(patientCategories).map(([category, meta]) => ({
    ...meta,
    entries: articles
        .filter((entry) => entry.data.category === (category as PatientCategory))
        .sort((a, b) => a.data.navigationOrder - b.data.navigationOrder),
}));
---

<LandingLayout
    title="Info pro pacienty"
    description="Srozumitelné informace k častým nemocem, léčbě, prevenci, očkování a praktickým záležitostem."
>
    {
        sections.map((section, sectionIndex) => (
            <section
                class:list={[
                    "landing-subsection",
                    { "landing-subsection--first": sectionIndex === 0 },
                ]}
                id={section.slug}
            >
                <div class="landing-intro">
                    <h2>{section.summary}</h2>
                </div>
                <div class="landing-grid">
                    {section.entries.map((entry) => (
                        <ArticleCard
                            href={entry.data.path}
                            title={entry.data.title}
                            description={entry.data.description}
                        />
                    ))}
                </div>
            </section>
        ))
    }

    <aside class="landing-support">
        <div>
            <p class="eyebrow">Nenašli jste odpověď?</p>
            <h2>Ozvěte se přímo do ordinace</h2>
            <p>
                Pokud si nejste jistí, kam váš dotaz patří, rádi vás
                nasměrujeme.
            </p>
        </div>
        <div class="actions">
            <a class="button" href={phoneHref(site.phone)}>
                Zavolat {site.phone}
            </a>
            <a class="button secondary" href={`mailto:${site.email}`}>
                Napsat e-mail
            </a>
        </div>
    </aside>
</LandingLayout>
