---
import TopicCard from "../../components/page-content/TopicCard.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { patientCategories, type PatientCategory } from "../../lib/articles";
import { getArticles } from "../../lib/collections";
import { getSite, phoneHref } from "../../lib/site";

const [articles, site] = await Promise.all([getArticles(), getSite()]);
const sections = Object.entries(patientCategories).map(([category, meta]) => ({
    ...meta,
    entries: articles.filter((entry) => entry.data.category === (category as PatientCategory)),
}));
---

<LandingLayout
    title="Info pro pacienty"
    description="Srozumitelné informace k častým nemocem, léčbě, prevenci, očkování a praktickým záležitostem."
    lead="Srozumitelné odpovědi na nejčastější otázky – od nemocí a prevence po úřední záležitosti."
>
    {
        sections.map((section) => (
            <section class="landing-subsection" id={section.slug} aria-labelledby={`${section.slug}-title`}>
                <h2 id={`${section.slug}-title`}>{section.title}</h2>
                <p class="lead">{section.summary}</p>
                <ul class="card-grid">
                    {section.entries.map((entry) => (
                        <TopicCard href={entry.data.path} title={entry.data.title} description={entry.data.description} cta="Přečíst" />
                    ))}
                </ul>
            </section>
        ))
    }

    <aside class="landing-support">
        <div>
            <p class="eyebrow">Nenašli jste odpověď?</p>
            <h2>Ozvěte se přímo do ordinace</h2>
            <p>Pokud si nejste jistí, kam váš dotaz patří, rádi vás nasměrujeme.</p>
        </div>
        <div class="actions">
            <a class="button" href={phoneHref(site.phone)}>Zavolat {site.phone}</a>
            <a class="button secondary" href={`mailto:${site.email}`}>Napsat e-mail</a>
        </div>
    </aside>
</LandingLayout>
