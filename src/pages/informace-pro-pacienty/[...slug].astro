---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
    PATIENT_INFO_PATH,
    categoryAnchor,
    patientCategories,
    type PatientCategory,
} from "../../lib/articles";

export async function getStaticPaths() {
    const articles = (await getCollection("articles"))
        .filter((entry) => entry.data.category !== "news")
        .sort((a, b) => a.data.navigationOrder - b.data.navigationOrder);

    return articles.map((entry) => ({
        // The content schema guarantees `path` starts with PATIENT_INFO_PATH.
        params: { slug: entry.data.path.slice(PATIENT_INFO_PATH.length, -1) },
        props: {
            entry,
            peers: articles.filter((peer) => peer.data.category === entry.data.category),
        },
    }));
}

interface Props {
    entry: CollectionEntry<"articles">;
    peers: CollectionEntry<"articles">[];
}

const { entry, peers } = Astro.props;
const { Content } = await render(entry);
const category = entry.data.category as PatientCategory;
const categoryTitle = patientCategories[category].title;
---

<ArticleLayout
    title={entry.data.title}
    description={entry.data.description}
    sources={entry.data.sources}
    breadcrumbs={[
        { label: "Domů", href: "/" },
        { label: "Info pro pacienty", href: PATIENT_INFO_PATH },
        { label: categoryTitle, href: categoryAnchor(category) },
        { label: entry.data.title },
    ]}
    sideNavigation={peers.map((peer) => ({
        href: peer.data.path,
        label: peer.data.title,
        current: peer.id === entry.id,
    }))}
    sideNavigationLabel={categoryTitle}
>
    <Content />
</ArticleLayout>
