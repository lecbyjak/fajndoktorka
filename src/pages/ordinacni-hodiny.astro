---
import LandingLayout from "../layouts/LandingLayout.astro";
import OfficeHours from "../components/structured/OfficeHours.astro";
import { getWeek } from "../lib/collections";
import { getSite, phoneHref } from "../lib/site";

const [week, site] = await Promise.all([getWeek(), getSite()]);

// The evening note is derived from the "prebooked" slots so it cannot drift from the schedule.
const listFormat = new Intl.ListFormat("cs", { type: "conjunction" });
const eveningSlots = week.flatMap((day) =>
    day.slots
        .filter((slot) => slot.purpose === "prebooked")
        .map((slot) => ({ day: day.day.toLocaleLowerCase("cs"), time: `${slot.from}–${slot.to}` })),
);
const eveningDays = listFormat.format([...new Set(eveningSlots.map(({ day }) => day))]);
const eveningTimes = listFormat.format(eveningSlots.map(({ day, time }) => `${day} ${time}`));
---

<LandingLayout
    title="Ordinační hodiny"
    description="Ordinační hodiny ordinace FajnDoktorka: akutní pacienti, objednaní pacienti, očkování a odběry."
>
    <section class="schedule-intro" aria-labelledby="schedule-intro-title">
        <div>
            <p class="eyebrow">Před návštěvou</p>
            <h2 id="schedule-intro-title">Objednejte se prosím předem</h2>
            <p>Při telefonickém objednání sdělte sestřičce stručně důvod návštěvy. Pomůže nám to vybrat vhodný čas a omezit čekání.</p>
        </div>
        <div class="schedule-contact">
            <span>Telefonické objednání</span>
            <a href={phoneHref(site.phone)}>{site.phone}</a>
            <small>V ordinační době</small>
        </div>
    </section>
    <section aria-labelledby="weekly-schedule-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Pondělí až pátek</p>
                <h2 id="weekly-schedule-title">Týdenní přehled</h2>
            </div>
            <p>Časy se liší podle typu návštěvy. Najděte svůj den a správný časový blok.</p>
        </div>
        <OfficeHours {week} />
    </section>
    <section class="schedule-meta" aria-label="Důležité informace k návštěvě">
        <div class="patient-order">
            <p class="eyebrow">Při příchodu</p>
            <h2>Pořadí ošetření</h2>
            <ol>
                <li><span>Velmi akutní stavy</span><small>Mají vždy přednost.</small></li>
                <li><span>Objednaní pacienti</span><small>Podle sjednaného času.</small></li>
                <li><span>Neobjednaní pacienti</span><small>Podle aktuální kapacity ordinace.</small></li>
            </ol>
        </div>
        {
            eveningSlots.length > 0 && (
                <div class="schedule-note">
                    <p class="eyebrow">{eveningDays}</p>
                    <h2>Večerní ordinace</h2>
                    <p>
                        <strong>Vyhrazeno pro preventivní prohlídky a kontroly pracujících a studujících klientů: {eveningTimes}.</strong>
                    </p>
                    <p>Lékař je přítomen pouze podle objednání a bez sestry. Tyto hodiny nejsou určené pro telefonické konzultace ani předpisy léků.</p>
                </div>
            )
        }
    </section>
</LandingLayout>
