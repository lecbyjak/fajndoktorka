---
import TopicCard from "../../components/page-content/TopicCard.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { getArticles } from "../../lib/collections";

const entries = await getArticles("news");
---

<LandingLayout title="Aktuality z ordinace" description="Aktuality a provozní informace z ordinace FajnDoktorka.">
    {
        entries.length > 0 ? (
            <ul class="card-grid">
                {entries.map((entry) => (
                    <TopicCard href={entry.data.path} title={entry.data.title} description={entry.data.description} cta="Přečíst" />
                ))}
            </ul>
        ) : (
            <div class="article">
                <h2>Aktuality se připravují</h2>
                <p>Nové příspěvky zde zveřejníme.</p>
            </div>
        )
    }
</LandingLayout>
