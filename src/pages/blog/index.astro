---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/page-content/ArticleCard.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";

const entries = (await getCollection("articles"))
    .filter((entry) => entry.data.category === "news")
    .sort((a, b) => a.data.navigationOrder - b.data.navigationOrder);
---

<LandingLayout
    title="Aktuality z ordinace"
    description="Aktuality a provozní informace z ordinace FajnDoktorka."
>
    {
        entries.length > 0 ? (
            <section class="landing-subsection landing-subsection--first">
                <div class="landing-intro">
                    <h2>Aktuální témata</h2>
                </div>
                <div class="landing-grid">
                    {entries.map((entry) => (
                        <ArticleCard
                            href={entry.data.path}
                            title={entry.data.title}
                            description={entry.data.description}
                        />
                    ))}
                </div>
            </section>
        ) : (
            <section class="article">
                <h2>Aktuality se připravují</h2>
                <p>Nové příspěvky zde zveřejníme.</p>
            </section>
        )
    }
</LandingLayout>
