---
import { getCollection } from "astro:content";
import LandingLayout from "../layouts/LandingLayout.astro";
import EquipmentList from "../components/structured/EquipmentList.astro";

const entries = await getCollection("equipment");
---

<LandingLayout
    title="Vyšetření přímo u nás"
    description="Přehled diagnostických přístrojů používaných v ordinaci FajnDoktorka."
    lead="Moderní přístroje nám pomáhají získat důležité výsledky rychle, šetrně a bez zbytečného odesílání na další pracoviště."
>
    <EquipmentList {entries} />
</LandingLayout>
