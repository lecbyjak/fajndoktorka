---
import { Font } from "astro:assets";
import Header from "../components/navigation/Header.astro";
import Link from "../components/navigation/Link.astro";
import Footer from "../components/footer/Footer.astro";
import { getSite, withBase } from "../lib/site";
import "../styles/global.css";

export interface Props {
    title: string;
    description: string;
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = await getSite();
// Page path without the deployment base, e.g. "/cenik/".
const currentPath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length) || "/";
const documentTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(currentPath, site.baseUrl);
---

<!doctype html>
<html lang="cs">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#98ec32" />
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex, follow" />}
        <title>{documentTitle}</title>
        {!noindex && <link rel="canonical" href={canonicalUrl} />}
        <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
        <meta property="og:locale" content="cs_CZ" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={documentTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        {/* Preload only the regular and heading weights; the rest load on demand. */}
        <Font
            cssVariable="--font-inter"
            preload={[
                { weight: 400, style: "normal" },
                { weight: 500, style: "normal" },
            ]}
        />
    </head>
    <body>
        <Link class="skip-link" href="#obsah">Přeskočit na obsah</Link>
        <Header {currentPath} />
        <slot />
        <Footer {site} />
        <script src="../scripts/site.ts"></script>
    </body>
</html>
