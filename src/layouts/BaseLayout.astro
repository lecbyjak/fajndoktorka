---
import { Font } from "astro:assets";
import Header from "../components/navigation/Header.astro";
import Link from "../components/navigation/Link.astro";
import Footer from "../components/footer/Footer.astro";
import { getSite, siteUrl } from "../lib/site";
import "../styles/global.css";
import "../styles/print.css";

export interface Props {
    title: string;
    description: string;
    currentPath?: string;
    image?: string | URL;
    noindex?: boolean;
    bodyClass?: string;
}

const {
    title,
    description,
    currentPath = Astro.url.pathname,
    image,
    noindex = false,
    bodyClass,
} = Astro.props;
const site = await getSite();
const siteName = site?.name ?? "Fajn doktorka";
const documentTitle = `${title} | ${siteName}`;
const siteOrigin = site?.baseUrl ?? Astro.site ?? Astro.url.origin;
const canonicalUrl = siteUrl(currentPath, siteOrigin);
const imageUrl = image ? new URL(image, siteOrigin) : undefined;
---

<!doctype html>
<html lang="cs">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#39735e" />
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex, follow" />}
        <title>{documentTitle}</title>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <meta property="og:locale" content="cs_CZ" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:title" content={documentTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        {imageUrl && <meta property="og:image" content={imageUrl} />}
        <Font cssVariable="--font-inter" preload />
        <slot name="head" />
    </head>
    <body class={bodyClass}>
        <Link class="skip-link" href="#obsah">Přeskočit na obsah</Link>
        <Header currentPath={currentPath} />
        <slot />
        <Footer {site} />
        <script src="../scripts/site.ts"></script>
    </body>
</html>
