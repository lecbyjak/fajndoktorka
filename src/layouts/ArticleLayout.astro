---
// Readable-width article on the white sheet, with optional external sources and a sticky side navigation.
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/page-content/PageHero.astro";
import SideNavigation, { type SideNavigationItem } from "../components/page-content/SideNavigation.astro";
import type { BreadcrumbItem } from "../components/page-content/Breadcrumbs.astro";
import { czechDate, isoDate } from "../lib/dates";

export interface Props {
    title: string;
    description: string;
    /** Intro under the title. Not defaulted: article descriptions are truncated excerpts. */
    lead?: string;
    breadcrumbs?: BreadcrumbItem[];
    /** News byline: author and dates come from front matter, not from the article body. */
    byline?: { author?: string; published: Date };
    sources?: { label: string; url: string }[];
    sideNavigation?: SideNavigationItem[];
    sideNavigationLabel?: string;
}

const { title, description, lead, breadcrumbs, byline, sources = [], sideNavigation = [], sideNavigationLabel } = Astro.props;
const hasSidebar = sideNavigation.length > 0;
---

<BaseLayout {title} {description}>
    <main id="obsah">
        <PageHero {title} {lead} {breadcrumbs} />
        <div class="sheet">
            <div class="shell">
                <div class:list={["content-layout", { "content-layout--single": !hasSidebar }]}>
                    <article class="article">
                        {
                            byline && (
                                <p class="article-meta">
                                    {byline.author && <span>{byline.author}</span>}
                                    <span>
                                        Zveřejněno <time datetime={isoDate(byline.published)}>{czechDate(byline.published)}</time>
                                    </span>
                                </p>
                            )
                        }
                        <slot />
                        {
                            sources.length > 0 && (
                                <section class="resources article-sources">
                                    <h2>Další zdroje</h2>
                                    <ul>
                                        {sources.map(({ label, url }) => (
                                            <li>
                                                <a href={url} target="_blank" rel="noopener noreferrer">
                                                    {label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </section>
                            )
                        }
                    </article>
                    {hasSidebar && <SideNavigation items={sideNavigation} label={sideNavigationLabel} />}
                </div>
            </div>
        </div>
    </main>
</BaseLayout>
