---
// Page hero on lavender, then the content on a white sheet rising over it.
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/page-content/PageHero.astro";

export interface Props {
    title: string;
    description: string;
    /** Intro under the title; defaults to the description. */
    lead?: string;
}

const { title, description, lead = description } = Astro.props;
---

<BaseLayout {title} {description}>
    <main id="obsah">
        <PageHero {title} {lead} />
        <div class="sheet">
            <div class="shell"><slot /></div>
        </div>
    </main>
</BaseLayout>
