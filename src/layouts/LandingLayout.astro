---
// Page hero followed by one full-width content section.
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/page-content/PageHero.astro";

export interface Props {
    title: string;
    description: string;
    /** Intro under the title; defaults to the description. */
    lead?: string;
}

const { title, description, lead = description } = Astro.props;
---

<BaseLayout {title} {description}>
    <main id="obsah">
        <PageHero {title} {lead} />
        <section class="section">
            <div class="shell"><slot /></div>
        </section>
    </main>
</BaseLayout>
