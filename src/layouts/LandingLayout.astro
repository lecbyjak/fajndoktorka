---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/page-content/PageHero.astro";
import type { BreadcrumbItem } from "../components/page-content/Breadcrumbs.astro";

export interface Props {
    title: string;
    description: string;
    currentPath?: string;
    eyebrow?: string;
    lead?: string;
    breadcrumbs?: BreadcrumbItem[];
    bodyClass?: string;
    noindex?: boolean;
}

const {
    title,
    description,
    currentPath,
    eyebrow,
    lead,
    breadcrumbs,
    bodyClass,
    noindex,
} = Astro.props;
---

<BaseLayout
    {title}
    {description}
    {currentPath}
    {bodyClass}
    {noindex}
>
    <main id="obsah">
        <PageHero {title} {eyebrow} {lead} {breadcrumbs} />
        <section class="section">
            <div class="shell landing-layout"><slot /></div>
        </section>
    </main>
</BaseLayout>
